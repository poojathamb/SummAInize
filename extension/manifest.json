{
  "manifest_version": 3,
  "name": "SummAInize",
  "version": "1.1",
  "description": "Summarize an AI chat to continue it in another account or tool.",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "action": {
    "default_popup": "page.html",
    "default_title": "SummAInize"
  }
}